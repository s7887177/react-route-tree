{
  "name": "@hdai-eason/react-route-tree",
  "type": "module",
  "version": "1.1.0",
  "description": "A generic React tree component for displaying routes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "tree",
    "router",
    "routes",
    "component",
    "ui"
  ],
  "author": "Eason Li",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s7887177/react-route-tree"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
